---
import type { Article } from '../types';
import { articleUrl, formatDate } from '../utils/site';

interface Props {
  article: Article;
  featured?: boolean;
  priority?: boolean;
}

const { article, featured = false, priority = false } = Astro.props;
---
<article class:list={['article-card', featured && 'article-card--featured']}>
  <a class="article-card-image" href={articleUrl(article.slug)} aria-label={`Ler: ${article.title}`}>
    <img src={article.image} alt={article.imageAlt} width="960" height="540" loading={priority ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <div class="article-card-body">
    <div class="article-card-meta">
      <span class="category-label">{article.category}</span>
      <span>{article.readTime}</span>
    </div>
    <h3><a href={articleUrl(article.slug)}>{article.title}</a></h3>
    <p>{article.description}</p>
    <div class="article-card-footer">
      <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
      <a class="text-link" href={articleUrl(article.slug)}>Ler artigo <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
