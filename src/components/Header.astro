---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/artigos/', label: 'Artigos' },
  { href: '/ferramentas/', label: 'Ferramentas' },
  { href: '/guias/', label: 'Guias' },
  { href: '/tutoriais/', label: 'Tutoriais' },
  { href: '/comparativos/', label: 'Comparativos' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="IA Descomplicada, início">
      <span class="brand-mark" aria-hidden="true">IA</span>
      <span class="brand-name">IA Descomplicada<small>Inteligência sem complicação</small></span>
    </a>

    <nav class="main-nav" aria-label="Navegação principal">
      {links.map((link) => <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>

    <div class="header-actions">
      <form class="header-search" action="/buscar/" role="search">
        <label class="sr-only" for="header-search">Buscar no site</label>
        <input id="header-search" name="q" type="search" placeholder="Buscar" autocomplete="off" />
        <button type="submit" aria-label="Pesquisar">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </form>
      <details id="mobile-navigation" class="mobile-nav" data-mobile-nav>
        <summary class="sr-only">Menu</summary>
        <form class="header-search" action="/buscar/" role="search">
          <label class="sr-only" for="mobile-search">Buscar no site</label>
          <input id="mobile-search" name="q" type="search" placeholder="O que você quer aprender?" autocomplete="off" />
          <button type="submit" aria-label="Pesquisar">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </form>
        <nav class="mobile-nav-links" aria-label="Navegação mobile">
          {links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="/prompts/">Prompts</a>
          <a href="/sobre/">Sobre</a>
          <a href="/contato/">Contato</a>
        </nav>
      </details>
      <button class="mobile-menu" type="button" aria-label="Abrir menu" aria-controls="mobile-navigation" aria-expanded="false" data-mobile-menu-button>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>
<script>
  const mobileMenuButton = document.querySelector<HTMLButtonElement>('[data-mobile-menu-button]');
  const mobileNavigation = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');

  const updateMobileMenuState = () => {
    mobileMenuButton?.setAttribute('aria-expanded', String(Boolean(mobileNavigation?.open)));
  };

  mobileMenuButton?.addEventListener('click', () => {
    if (mobileNavigation) mobileNavigation.open = !mobileNavigation.open;
    updateMobileMenuState();
  });

  mobileNavigation?.addEventListener('toggle', updateMobileMenuState);
</script>
