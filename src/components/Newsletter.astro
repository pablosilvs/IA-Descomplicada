<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="container newsletter-inner">
    <div>
      <h2 id="newsletter-title">Receba os melhores conteúdos sobre IA</h2>
      <p>Uma seleção prática de guias, ferramentas e ideias para usar inteligência artificial com mais critério.</p>
    </div>
    <div>
      <form class="newsletter-form" data-newsletter-form>
        <label class="sr-only" for="newsletter-email">Seu melhor e-mail</label>
        <input id="newsletter-email" name="email" type="email" placeholder="seu@email.com" autocomplete="email" required />
        <button type="submit">Quero receber</button>
      </form>
      <p class="newsletter-status" data-newsletter-status aria-live="polite"></p>
      <p class="form-note">Interface pronta. A integração de e-mail será conectada antes da publicação.</p>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.parentElement?.querySelector('[data-newsletter-status]');
      if (status) status.textContent = 'Obrigado pelo interesse. A lista ainda está em preparação.';
    });
  });
</script>
