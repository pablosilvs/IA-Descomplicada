---
import type { Tool } from '../types';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const initials = tool.name.split(' ').map((part) => part[0]).slice(0, 2).join('');
const domain = new URL(tool.url).hostname.replace(/^www\./, '');
const logoUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=128`;
---
<article class="tool-card" style={`--tool-accent: ${tool.accent}`}>
  <div class="tool-card-top">
    <span class="tool-icon" aria-hidden="true">
      <span class="tool-icon-fallback" aria-hidden="true">{initials}</span>
      <img src={logoUrl} alt="" width="32" height="32" loading="lazy" decoding="async" />
    </span>
    <span class="tool-level">{tool.level}</span>
  </div>
  <h2>{tool.name}</h2>
  <p>{tool.description}</p>
  <p class="tool-card-use"><strong>Serve para:</strong> {tool.use}</p>
  <div class="tool-card-footer">
    <span class="tool-category">{tool.category}</span>
    <a class="official-link" href={tool.url} target="_blank" rel="noopener noreferrer">Site oficial ↗</a>
  </div>
</article>
