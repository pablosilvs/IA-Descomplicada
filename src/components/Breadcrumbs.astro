---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Início</a>
  {items.map((item) => (
    <>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
    </>
  ))}
</nav>
