---
import { contactEmail } from '../utils/site';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="IA Descomplicada, início">
        <span class="brand-mark" aria-hidden="true">IA</span>
        <span class="brand-name">IA Descomplicada<small>Inteligência sem complicação</small></span>
      </a>
      <p>Conteúdo educativo sobre inteligência artificial para decisões mais claras no trabalho, nos estudos e no dia a dia.</p>
    </div>
    <div>
      <p class="footer-heading">Explorar</p>
      <ul class="footer-links">
        <li><a href="/artigos/">Todos os artigos</a></li>
        <li><a href="/ferramentas/">Ferramentas de IA</a></li>
        <li><a href="/guias/">Guias</a></li>
        <li><a href="/tutoriais/">Tutoriais</a></li>
        <li><a href="/comparativos/">Comparativos</a></li>
        <li><a href="/prompts/">Prompts</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-heading">O projeto</p>
      <ul class="footer-links">
        <li><a href="/sobre/">Sobre</a></li>
        <li><a href="/contato/">Contato</a></li>
        <li><a href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
        <li><a href="/politica-de-privacidade/">Privacidade</a></li>
        <li><a href="/termos-de-uso/">Termos de uso</a></li>
        <li><a href="/politica-de-cookies/">Cookies</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} IA Descomplicada. Conteúdo educativo sobre inteligência artificial.</p>
    <p>Feito para aprender, testar e usar melhor.</p>
  </div>
</footer>
