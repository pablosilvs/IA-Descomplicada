---
import AdSlot from '../components/AdSlot.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from './BaseLayout.astro';
import type { Article } from '../types';
import { articleUrl, formatDate } from '../utils/site';

interface Props {
  article: Article;
  related: Article[];
}

const { article, related } = Astro.props;
const siteOrigin = Astro.site?.origin || 'https://ia-descomplicadaoofc.netlify.app';
const articleUrlAbsolute = new URL(articleUrl(article.slug), siteOrigin).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  image: [article.image],
  datePublished: article.publishedAt,
  dateModified: article.updatedAt,
  mainEntityOfPage: articleUrlAbsolute,
  author: { '@type': 'Organization', name: article.author, url: new URL('/sobre/', siteOrigin).toString() },
  publisher: {
    '@type': 'Organization',
    name: 'IA Descomplicada',
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteOrigin).toString() },
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: siteOrigin },
    { '@type': 'ListItem', position: 2, name: 'Artigos', item: new URL('/artigos/', siteOrigin).toString() },
    { '@type': 'ListItem', position: 3, name: article.title, item: articleUrlAbsolute },
  ],
};
const faqSchema = article.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: article.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : undefined;
const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---
<BaseLayout title={article.title} description={article.description} image={article.image} type="article" structuredData={schemas}>
  <header class="article-hero">
    <div class="container article-hero-inner">
      <Breadcrumbs items={[{ label: 'Artigos', href: '/artigos/' }, { label: article.title }]} />
      <p class="eyebrow">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="article-deck">{article.description}</p>
      <div class="article-meta">
        <span>Por <a href="/sobre/"><strong>{article.author}</strong></a></span>
        <span aria-hidden="true">·</span>
        <time datetime={article.publishedAt}>Publicado em {formatDate(article.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>Atualizado em {formatDate(article.updatedAt)}</span>
        <span aria-hidden="true">·</span>
        <span>{article.readTime}</span>
      </div>
    </div>
  </header>

  <figure class="article-cover">
    <img src={article.image} alt={article.imageAlt} width="1400" height="700" loading="eager" decoding="async" />
  </figure>

  <div class="container article-layout">
    <article class="article-main">
      <div class="article-body" set:html={article.body}></div>
      <AdSlot />

      {article.faqs && (
        <section class="faq-list" aria-labelledby="faq-title">
          <h2 id="faq-title">Perguntas frequentes</h2>
          {article.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </section>
      )}

      <div class="article-disclaimer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M12 10.5v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="7.3" r="1" fill="currentColor"/></svg>
        <span>Ferramentas de inteligência artificial podem gerar informações incorretas. Verifique informações importantes em fontes confiáveis.</span>
      </div>

      <div class="article-tags" aria-label="Tags do artigo">
        {article.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </article>

    <aside class="article-sidebar">
      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title">Neste artigo</h2>
        <ol>
          {article.toc.map((item) => <li data-level={item.level}><a href={`#${item.id}`}>{item.label}</a></li>)}
        </ol>
      </nav>
    </aside>
  </div>

  <section class="section related-section" aria-labelledby="related-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Continue explorando</p>
          <h2 id="related-title">Conteúdos relacionados</h2>
        </div>
        <a class="text-link" href="/artigos/">Ver todos os artigos <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list">
        {related.map((candidate) => <ArticleCard article={candidate} />)}
      </div>
    </div>
  </section>
</BaseLayout>
