---
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../content/articles';
import { tools } from '../content/tools';
import { contactEmail } from '../utils/site';

const featured = articles.slice(0, 3);
const latest = [...articles].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt)).slice(0, 6);
const guides = articles.filter((article) => article.section === 'guia').slice(0, 3);
const tutorials = articles.filter((article) => article.section === 'tutorial').slice(0, 3);
const comparisons = articles.filter((article) => article.section === 'comparativo');
const categories = [
  { name: 'Chatbots', description: 'Converse e organize ideias', href: '/ferramentas/#chatbots', symbol: '◌' },
  { name: 'Imagem', description: 'Crie e edite visuais', href: '/ferramentas/#imagem', symbol: '✦' },
  { name: 'Vídeo', description: 'Explore narrativas visuais', href: '/ferramentas/#video', symbol: '▶' },
  { name: 'Áudio', description: 'Voz, som e transcrição', href: '/ferramentas/#audio', symbol: '◖' },
  { name: 'Programação', description: 'Código com mais contexto', href: '/ferramentas/#programacao', symbol: '</>' },
  { name: 'Produtividade', description: 'Trabalhe melhor com IA', href: '/ferramentas/#produtividade', symbol: '↗' },
];
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IA Descomplicada',
  url: Astro.site?.toString() || 'https://descomplica-iaofc.netlify.app/',
  description: 'Inteligência Artificial sem complicação.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.site?.toString().replace(/\/$/, '') || 'https://descomplica-iaofc.netlify.app'}/buscar/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'IA Descomplicada',
  url: Astro.site?.toString() || 'https://descomplica-iaofc.netlify.app/',
  logo: new URL('/favicon.svg', Astro.site || 'https://descomplica-iaofc.netlify.app').toString(),
  description: 'Conteúdo educativo sobre inteligência artificial.',
  email: contactEmail,
};
---
<BaseLayout title="IA Descomplicada | Inteligência Artificial sem complicação" description="Guias, ferramentas, tutoriais e comparativos para você aproveitar melhor a inteligência artificial no trabalho, nos estudos e no dia a dia." structuredData={[websiteSchema, organizationSchema]}>
  <section class="home-hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">Portal brasileiro de IA</p>
        <h1>Inteligência Artificial <span>sem complicação.</span></h1>
        <p>Guias, ferramentas, tutoriais e comparativos para você aproveitar melhor a inteligência artificial no trabalho, nos estudos e no dia a dia.</p>
        <div class="hero-actions">
          <a class="button button--light" href="/artigos/">Explorar conteúdos <span aria-hidden="true">→</span></a>
          <a class="button" href="/ferramentas/">Conhecer ferramentas</a>
        </div>
        <p class="hero-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4.2 4.2L19 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Conteúdo pensado para pessoas, não para o hype.
        </p>
      </div>
      <div class="hero-panel" aria-label="O que você encontra no portal">
        <div class="hero-panel-top">Mapa do portal</div>
        <h2>Aprenda o essencial. Teste com critério.</h2>
        <p>Um ponto de partida claro para transformar curiosidade em uso prático.</p>
        <div class="hero-panel-list">
          <span>Tutoriais passo a passo</span>
          <span>Comparativos sem torcida</span>
          <span>Prompts para adaptar</span>
          <span>Cuidados para decidir melhor</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Seleção editorial</p>
          <h2 id="featured-title">Conteúdos em destaque</h2>
          <p>Comece por explicações e métodos que continuam úteis mesmo quando as ferramentas mudam.</p>
        </div>
        <a class="text-link" href="/artigos/">Ver tudo <span aria-hidden="true">→</span></a>
      </div>
      <div class="featured-grid">
        {featured.map((article, index) => <ArticleCard article={article} featured={index === 0} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Sempre atualizado</p>
          <h2 id="latest-title">Últimos artigos</h2>
        </div>
        <a class="text-link" href="/artigos/">Todos os artigos <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list">
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Encontre seu ponto de partida</p>
          <h2 id="tools-title">Ferramentas de IA</h2>
          <p>Explore por tipo de tarefa e confira o site oficial antes de criar uma conta ou compartilhar qualquer dado.</p>
        </div>
        <a class="text-link" href="/ferramentas/">Ver ferramentas <span aria-hidden="true">→</span></a>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={category.href}>
            <span class="category-icon" aria-hidden="true">{category.symbol}</span>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
          </a>
        ))}
      </div>
      <p class="form-note" style="margin-top: 14px;">{tools.length} opções catalogadas com links oficiais e descrição editorial.</p>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="guides-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Para criar uma base</p>
          <h2 id="guides-title">Guias para começar</h2>
        </div>
        <a class="text-link" href="/guias/">Ver guias <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list">
        {guides.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tutorials-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Faça junto</p>
          <h2 id="tutorials-title">Tutoriais populares</h2>
          <p>Passos concretos para tirar a IA da curiosidade e colocar em uma tarefa real.</p>
        </div>
        <a class="text-link" href="/tutoriais/">Ver tutoriais <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list">
        {tutorials.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="compare-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Escolha com contexto</p>
          <h2 id="compare-title">Comparativos</h2>
        </div>
        <a class="text-link" href="/comparativos/">Ver comparativos <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-list article-list--two">
        {comparisons.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="prompt-title">
    <div class="container">
      <div class="prompt-strip">
        <div>
          <p class="eyebrow">Biblioteca prática</p>
          <h2 id="prompt-title">Prompts que começam com o problema certo.</h2>
          <p>Modelos para adaptar a estudos, textos, planejamento e revisão. Sem fórmula mágica: só contexto, critério e espaço para conferir.</p>
          <a class="button button--secondary" href="/prompts/">Explorar prompts <span aria-hidden="true">→</span></a>
        </div>
        <div class="prompt-example" aria-label="Exemplo de prompt">Objetivo: transformar minhas anotações em um plano.<br />Contexto: tenho 45 minutos e preciso decidir os próximos passos.<br />Formato: tabela com ação, responsável, prazo e dúvida em aberto.<br />Regra: não invente informações ausentes.</div>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
